# ====================================================================
# Full-Stack WebExplorer (.NET 10 & Next.js / TypeScript) .gitignore
# ====================================================================

# --------------------------------------------------------------------
# Node.js & Next.js (Frontend)
# --------------------------------------------------------------------
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/logs/
*.log

# Runtime & Environment files
.env
.env*.local
!.env.example

# Next.js telemetry & cache
.next/cache/

# --------------------------------------------------------------------
# .NET / C# / Visual Studio (Backend)
# --------------------------------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Tt]emp/
**/TestResults/

# User-specific files & Visual Studio cache
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vs/

# Roslyn and compiler crash reports
*.crash
*.dump

# NuGet packages
**/packages/
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# Rider / JetBrains
.idea/
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --------------------------------------------------------------------
# Databases & Backups (MSSQL, LocalDB, SQLite)
# --------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.bak
*.db
*.sqlite
*.sqlite3

# --------------------------------------------------------------------
# Operating System Files
# --------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --------------------------------------------------------------------
# AI & Local Development Assistants
# --------------------------------------------------------------------
.gemini/
.claude/
